{
  "name": "campus-student-information-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev --workspace=backend\" \"npm:dev --workspace=frontend\"",
    "build": "npm --prefix frontend run build",
    "start": "npm run start --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
